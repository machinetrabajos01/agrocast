# Copy to .env and fill in. Never commit the real values.

# Flask session signing key (any long random string).
FLASK_SECRET_KEY=change-me

# Supabase Postgres through the Supavisor pooler, using the dedicated agrocast_app role
# (see supabase/app_role.example.sql). Leave empty to use a local SQLite file (instance/agrocast.db).
DATABASE_URL=postgresql+psycopg://agrocast_app.<project-ref>:<password>@aws-1-us-east-1.pooler.supabase.com:5432/postgres

# Set to 1 when the site is served over HTTPS.
SESSION_COOKIE_SECURE=0

# Only for src/load_supabase.py (pipeline results in the public schema). The service role never goes to the repository.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
